    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state = $getWorkflowStaticData('global');\nfor (const item of $input.all()) {\n  const result = item.json;\n  if (!state.results) state.results = {};\n  if (result && result.domain) state.results[result.domain] = result;\n}\nif (state.emitted || !state.expected) return [];\nconst complete = state.expected.every((domain) => state.results[domain]);\nif (!complete) return [];\nstate.emitted = true;\nreturn [{ json: { results: state.expected.map((domain) => state.results[domain]) } }];"
      },
      "id": "9d4f1a10-0001-4a01-9001-000000000017",
      "name": "Collect Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        40
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const collected = $input.first()?.json?.results;\nconst results = Array.isArray(collected)\n  ? collected\n  : $input.all().map((item) => item.json);\nconst suspicious = results.filter((result) => result.verdict === 'suspicious');\nconst benign = results.filter((result) => result.verdict === 'benign');\nconst report = {\n  generatedAt: new Date().toISOString(),\n  total: results.length,\n  suspicious: suspicious.length,\n  benign: benign.length,\n  domains: results.map((result) => ({\n    domain: result.domain,\n    probability_DGA: result.probability_DGA,\n    verdict: result.verdict,\n    severity: result.severity,\n    vt_status: result.vt_status,\n    vt_detected: (result.vt?.report?.summary?.taxonomies ?? result.vt?.summary?.taxonomies ?? []).map((taxonomy) => taxonomy.value),\n    whois_registrar: result.whois?.registrar ?? 'Not available',\n    whois_country: result.whois?.country ?? 'Not provided',\n    dns_a: result.dns?.A ?? [],\n    dns_ns: result.dns?.NS ?? []\n  }))\n};\nreturn [{ json: { report, promptText: JSON.stringify(report, null, 2) } }];"
      },
      "id": "9d4f1a10-0001-4a01-9001-000000000018",
      "name": "Build Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        40
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const provider = String($env.LLM_PROVIDER || 'groq').toLowerCase();\nconst apiKey = String($env.LLM_API_KEY || '');\nconst model = String($env.LLM_MODEL || (provider === 'gemini' ? 'gemini-2.5-flash' : 'openai/gpt-oss-20b'));\nconst prompt = 'You are a SOC analyst. Write a concise report for the following DNS/DGA triage results. Use these sections: Executive summary, Suspicious domains, Benign domains, VirusTotal verdicts, WHOIS observations, DNS observations, Recommended actions. Keep it factual and short. Include WHOIS registrar and country only when the data contains them. Never claim country when it says Not provided. Data:\\n' + $json.promptText;\nlet url;\nlet body;\nif (provider === 'gemini') {\n  url = 'https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent?key=' + encodeURIComponent(apiKey);\n  body = { contents: [{ parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 2048 } };\n} else {\n  url = 'https://api.groq.com/openai/v1/chat/completions';\n  body = { model, temperature: 0.2, max_tokens: 2048, messages: [{ role: 'user', content: prompt }] };\n}\nreturn [{ json: { url, body: JSON.stringify(body), provider, model, hasKey: apiKey.length > 0, prompt, report: $json.report } }];"
      },
      "id": "9d4f1a10-0001-4a01-9001-000000000019",
      "name": "Prepare LLM",
      "type": "n8n-nodes-base.code",
