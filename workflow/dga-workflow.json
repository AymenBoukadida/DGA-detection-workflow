    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const response = $input.item.json || {};\nconst prepared = $('Prepare LLM').item.json;\nconst gemini = (response.candidates?.[0]?.content?.parts ?? []).map((part) => part.text || '').join('\\n').trim();\nconst groq = (response.choices?.[0]?.message?.content ?? '').trim();\nconst summary = gemini || groq;\nconst fallback = 'No LLM used (' + prepared.provider + '/' + prepared.model + '). Set LLM_API_KEY in .env and rerun for narrative summary. Raw triage report:\\n\\n' + prepared.prompt;\nreturn { json: { ...prepared.report, summary: summary || fallback, summary_source: summary ? prepared.provider : 'fallback' } };"
      },
