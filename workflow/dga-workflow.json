    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const score = $('Score').item.json;\nconst answer = (response) => Array.isArray(response?.Answer) ? response.Answer.map((record) => record.data) : [];\nreturn {\n  json: {\n    domain: score.domain,\n    probability_DGA: score.probability_DGA,\n    label: score.label,\n    severity: score.severity,\n    verdict: 'benign',\n    vt_status: 'skipped',\n    vt: null,\n    whois: $('WHOIS benign').item.json,\n    dns: { A: answer($('DNS A').item.json), NS: answer($('DNS NS').item.json) }\n  }\n};"
      },
      "id": "9d4f1a10-0001-4a01-9001-000000000016",
      "name": "Assemble benign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        200
      ]
