# Copy to .env and fill the values marked CHANGEME.
# .env is git-ignored and must never be committed.

# Service secrets (any long random string)
THEHIVE_SECRET=CHANGEME_THEHIVE_SECRET
CORTEX_SECRET=CHANGEME_CORTEX_SECRET
N8N_ENCRYPTION_KEY=CHANGEME_N8N_ENCRYPTION_KEY

# n8n owner account created by the bootstrap step
N8N_OWNER_EMAIL=admin@dga.lab
N8N_OWNER_PASSWORD=CHANGEME_N8N_OWNER_PASSWORD
N8N_OWNER_FIRST_NAME=SOC
N8N_OWNER_LAST_NAME=Analyst

# TheHive superadmin (created automatically on first start)
THEHIVE_ADMIN_USER=admin@thehive.local
THEHIVE_ADMIN_PASSWORD=secret

# Cortex superadmin (created by the bootstrap step)
CORTEX_ADMIN_USER=admin
CORTEX_ADMIN_PASSWORD=secret

# Organisation and analyst account used by the workflow
LAB_ORG=soc
LAB_USER=analyst@soc.local
LAB_USER_PASSWORD=CHANGEME_ANALYST_PASSWORD

# External services
VT_API_KEY=
APININJAS_API_KEY=

# Report summary. Groq free tier: console.groq.com. Gemini also supported.
# LLM_PROVIDER=groq or gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=

# MailHog catches every message, no SMTP account needed
SMTP_FROM=soc@dga.lab
SMTP_TO=analyst@dga.lab

# Docker daemon path of the cortex-jobs volume. Cortex passes it to analyzer containers.
# Keep this value unless the Compose project name changes.
CORTEX_JOB_DIR=/var/lib/docker/volumes/dga-detection-workflow_cortex-jobs/_data
